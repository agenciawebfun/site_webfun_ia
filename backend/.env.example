# Exemplo de variáveis de ambiente para Railway.app
# Configure estas variáveis no dashboard do Railway: Settings → Variables

# Django (gerar nova SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=sua-chave-secreta-unica-aqui-min-50-caracteres
DEBUG=False

# Hosts permitidos (Railway + seu domínio customizado se tiver)
ALLOWED_HOSTS=*.railway.app,seudominio.com.br

# Database (Railway cria DATABASE_URL automaticamente quando você adiciona PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS - permitir seu frontend Hostinger
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://seusite.com.br,https://www.seusite.com.br

# CSRF - incluir Railway domain + frontend domain
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://seusite.com.br,https://www.seusite.com.br
